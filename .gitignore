# Python bytecode from tools/
__pycache__/
*.py[cod]

# Raw captures. They are the input to tools/crop_screenshots.py and
# tools/redact_screenshots.py, not site assets — everything the site shows is a
# derived crop committed alongside them. Keeping the raws out of the repo is not
# tidiness: this repo is published as-is, and the raw web-scan captures still
# carry the real third-party domain the redaction exists to remove.
assets/Screenshots/**/ShareCare0*.png
assets/Screenshots/**/SecurityPortal0*.png
assets/Screenshots/**/WebScan0*.png
!assets/Screenshots/ShareCare/ShareCare05.png
!assets/Screenshots/WebScan/WebScan02-redacted.png

# OS and editor cruft
Thumbs.db
.DS_Store
*.swp
.vscode/
.idea/

# WebP twins of the raw captures above. tools/build_images.py derives its work list from
# `git ls-files` precisely so it can never create these, but the ignore rules above only match
# *.png — a stray .webp would sail past them and publish the very capture the redaction removes.
assets/Screenshots/**/ShareCare0*.webp
assets/Screenshots/**/SecurityPortal0*.webp
assets/Screenshots/**/WebScan0*.webp
!assets/Screenshots/ShareCare/ShareCare05.webp
!assets/Screenshots/WebScan/WebScan02-redacted.webp
